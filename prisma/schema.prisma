generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Page {
  id              String    @id @default(cuid())
  title           String?
  slug            String    @unique
  parent          String    @default("-")
  order           Int       @default(0)
  type            String    @default("standard")
  visibility      String    @default("draft")
  isStatic        Boolean   @default(false)
  description     String?
  metaTitle       String?
  metaDescription String?
  targetKeywords  String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)
  featuredImage   String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  schema          String?
  headingOptions  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sections        Section[]
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  content   Json     @default("{}")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  shortDesc   String?
  fullDesc    String?
  coverImage  String?
  order       Int      @default(0)
  isFeatured  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  subtitle            String?
  categorySlug        String
  categoryName        String
  subCategoryTitle    String?
  containerImage      String?
  description         String?
  applicationAreas    String?
  performanceBenefits Json?            @default("[]")
  specialFeatures     Json?            @default("[]")
  specsText           String?
  tableHeaders        Json?            @default("[\"Property\", \"Value\"]")
  propertiesTable     Json?            @default("[]")
  pdfUrl              String?
  msdsUrl             String?
  isFeatured          Boolean          @default(false)
  order               Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  category            ProductCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
}

model BlogPost {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  category            String   @default("Automotive")
  publishDate         String
  readTime            String   @default("5 min read")
  author              String   @default("HPCL Technical Team")
  excerpt             String
  coverImage          String?
  content             Json     @default("{}")
  recommendedProducts Json?    @default("[]")
  isPublished         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  date        String
  category    String   @default("Expo")
  location    String
  description String
  image       String?
  gallery     Json?    @default("[]")
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfficeLocation {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("Branch Depot")
  address       String
  phone         String?
  email         String?
  contactPerson String?
  mapUrl        String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Enquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  interestedIn String?
  product      String?
  budget       String?
  message      String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DistributorApplication {
  id               String   @id @default(cuid())
  name             String
  firmName         String
  email            String
  phone            String
  city             String
  state            String
  existingBusiness String?
  annualTurnover   String?
  experienceYears  String?
  message          String?
  status           String   @default("Pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NavLink {
  id          String   @id @default(cuid())
  label       String
  url         String
  type        String   @default("Main Link")
  parent      String   @default("-")
  order       Int      @default(0)
  description String?
  title       String?
  isStatic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalConfig {
  id                  String   @id @default("global")
  siteTitle           String
  siteDescription     String
  favicon             String?
  logo                String?
  phone               String?
  email               String?
  address             String?
  googleAnalyticsId   String?
  gtmId               String?
  searchConsoleId     String?
  customHeaderScripts String?
  customFooterScripts String?
  socialLinks         Json?
  canonicalOrdering   String   @default("default")
  sitemapEnabled      Boolean  @default(true)
  sitemapCustomContent String?
  robotsTxt           String?  @default("User-agent: *\nAllow: /\n\nSitemap: https://mahalaxmilubricants.com/sitemap.xml")
  schema              String?
  headingOptions      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
